[ -f ~/.bashrc ] && . ~/.bashrc
unset HISTFILE
HISTSIZE=100000
HISTCONTROL=
HISTIGNORE=
HISTTIMEFORMAT=
set -o history
__aayat_mark() {
  local e=$? n c
  c=$(history 1)
  n=$(printf '%s' "$c" | sed -nE '1s/^ *([0-9]+).*/\1/p')
  c=$(printf '%s' "$c" | sed -E '1s/^ *[0-9]+\*? +//')
  printf '\033]7771;P;%s;%s;%s;%s\007' "$e" "$(printf '%s' "$PWD" | base64 -w0)" "$n" "$(printf '%s' "$c" | base64 -w0)"
  return $e
}
PROMPT_COMMAND="__aayat_mark${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
PS0='\e]7771;S\a'
PS1='\[\e[1;36m\]studio\[\e[0m\]:\[\e[1;33m\]\W\[\e[0m\]\$ '
