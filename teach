#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
PY=""
for c in .venv/bin/python .venv/Scripts/python python3 python; do
  if "$c" -c 'import rcssmin' >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "No Python here has the site's packages. Install them with: pip install -r requirements.txt"
  exit 1
fi
exec "$PY" tools/teach.py "$@"
