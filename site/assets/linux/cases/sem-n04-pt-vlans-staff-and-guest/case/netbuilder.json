{
 "lab": "n04",
 "program": "netsim",
 "title": "Network lab 4: VLANs for staff and guests",
 "intro": "Tulsi Travels' front office has one switch. Staff and visiting customers must not share a network.",
 "devices": [
  {
   "id": "sw1",
   "kind": "switch",
   "name": "sw1",
   "x": 380,
   "y": 190,
   "ports": 26
  },
  {
   "id": "staff-1",
   "kind": "pc",
   "name": "staff-1",
   "x": 100,
   "y": 70,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  },
  {
   "id": "staff-2",
   "kind": "pc",
   "name": "staff-2",
   "x": 100,
   "y": 220,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  },
  {
   "id": "guest-1",
   "kind": "pc",
   "name": "guest-1",
   "x": 660,
   "y": 70,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  },
  {
   "id": "guest-2",
   "kind": "pc",
   "name": "guest-2",
   "x": 660,
   "y": 220,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  }
 ],
 "cables": [],
 "swports": {},
 "vlanNames": {},
 "tasks": [
  {
   "id": "t1",
   "text": "Cable staff-1 and staff-2 to Fa0/1 and Fa0/2, guest-1 and guest-2 to Fa0/13 and Fa0/14, and give them the plan's addresses",
   "check": {
    "all": [
     {
      "cable": "sw1:1",
      "to": "staff-1"
     },
     {
      "cable": "sw1:2",
      "to": "staff-2"
     },
     {
      "cable": "sw1:13",
      "to": "guest-1"
     },
     {
      "cable": "sw1:14",
      "to": "guest-2"
     },
     {
      "dev": "staff-1",
      "ip": "192.168.10.11",
      "bits": 24
     },
     {
      "dev": "staff-2",
      "ip": "192.168.10.12",
      "bits": 24
     },
     {
      "dev": "guest-1",
      "ip": "192.168.20.31",
      "bits": 24
     },
     {
      "dev": "guest-2",
      "ip": "192.168.20.32",
      "bits": 24
     }
    ]
   },
   "hint": "Set Cable to Copper Straight-Through so you can pick the switch port. Addresses go in each PC's panel on the right.",
   "keep": true
  },
  {
   "id": "t2",
   "text": "Create VLAN 10 named STAFF and VLAN 20 named GUEST",
   "check": {
    "all": [
     {
      "vlanName": "sw1:10",
      "is": "STAFF"
     },
     {
      "vlanName": "sw1:20",
      "is": "GUEST"
     }
    ]
   },
   "hint": "CLI and Desktop tab, sw1: enable, configure terminal, vlan 10, name STAFF."
  },
  {
   "id": "t3",
   "text": "Put ports 1 to 12 in VLAN 10 and ports 13 to 20 in VLAN 20, all as access ports",
   "check": {
    "all": [
     {
      "port": "sw1:1",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:2",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:3",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:4",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:5",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:6",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:7",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:8",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:9",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:10",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:11",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:12",
      "vlan": 10,
      "mode": "access"
     },
     {
      "port": "sw1:13",
      "vlan": 20,
      "mode": "access"
     },
     {
      "port": "sw1:14",
      "vlan": 20,
      "mode": "access"
     },
     {
      "port": "sw1:15",
      "vlan": 20,
      "mode": "access"
     },
     {
      "port": "sw1:16",
      "vlan": 20,
      "mode": "access"
     },
     {
      "port": "sw1:17",
      "vlan": 20,
      "mode": "access"
     },
     {
      "port": "sw1:18",
      "vlan": 20,
      "mode": "access"
     },
     {
      "port": "sw1:19",
      "vlan": 20,
      "mode": "access"
     },
     {
      "port": "sw1:20",
      "vlan": 20,
      "mode": "access"
     }
    ]
   },
   "hint": "interface range fa0/1-12, then switchport mode access, switchport access vlan 10."
  },
  {
   "id": "t4",
   "text": "Ping staff-2 from staff-1, and see guest-1 fail",
   "check": {
    "all": [
     {
      "flag": "ping:staff-1>staff-2:ok"
     },
     {
      "flag": "ping:staff-1>guest-1:fail"
     }
    ]
   },
   "hint": "CLI and Desktop tab, staff-1: ping 192.168.10.12 then ping 192.168.20.31.",
   "keep": true
  },
  {
   "id": "t5",
   "text": "Give guest-1 the staff address 192.168.10.99 and see that ping to staff-1 still fails",
   "check": {
    "all": [
     {
      "dev": "guest-1",
      "ip": "192.168.10.99",
      "bits": 24
     },
     {
      "ping": [
       "guest-1",
       "staff-1"
      ],
      "ok": false
     }
    ]
   },
   "hint": "The switch port decides the VLAN, not the address.",
   "keep": true
  }
 ]
}
