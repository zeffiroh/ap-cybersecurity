 "tasks": [
  {
   "id": "t1",
   "text": "Cable switch Gi0/1 to router G0/0 and make the switch port a trunk",
   "check": {
    "all": [
     {
      "cable": "sw1:25",
      "to": "r1"
     },
     {
      "port": "sw1:25",
      "mode": "trunk"
     }
    ]
   },
   "hint": "Set Cable to Copper Straight-Through, click the switch then the router, and pick Gi0/1 and G0/0. On the switch: interface gi0/1, switchport mode trunk."
  },
  {
   "id": "t2",
   "text": "Bring G0/0 up and make subinterface g0/0.10 (VLAN 10, 192.168.10.1/24)",
   "check": {
    "all": [
     {
      "ifup": [
       "r1",
       "g0/0"
      ]
     },
     {
      "ifvlan": [
       "r1",
       "g0/0.10",
       10
      ]
     },
     {
      "ifip": [
       "r1",
       "g0/0.10",
       "192.168.10.1/24"
      ]
     }
    ]
   },
   "hint": "Router console: interface g0/0, no shutdown, then interface g0/0.10, encapsulation dot1Q 10, ip address 192.168.10.1 255.255.255.0."
  },
  {
   "id": "t3",
   "text": "Make subinterface g0/0.20 (VLAN 20, 192.168.20.1/24)",
   "check": {
    "all": [
     {
      "ifvlan": [
       "r1",
       "g0/0.20",
       20
      ]
     },
     {
      "ifip": [
