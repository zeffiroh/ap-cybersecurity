. /usr/local/bin/aayat-net
net_ready traceroute
host=""
for a in "$@"; do case "$a" in -h|--help) echo "Usage: traceroute HOST   (lab copy)"; exit 0 ;; -*) ;; *) host="$a" ;; esac; done
[ -z "$host" ] && { echo "Usage: traceroute HOST"; exit 1; }
ip=$(resolve "$host")
[ -z "$ip" ] && { echo "traceroute: bad address '$host'"; exit 1; }
echo "traceroute to $host ($ip), 30 hops max, 46 byte packets"
gw=$(gateway)
hop() { printf "%2d  %s  %s ms  %s ms  %s ms\n" "$1" "$2" "$(ms "$(($1 * 10 + 1))" "$3")" "$(ms "$(($1 * 10 + 2))" "$3")" "$(ms "$(($1 * 10 + 3))" "$3")"; }
if private "$ip"; then
  if [ "$ip" = "$gw" ]; then hop 1 "$(name_of "$ip") ($ip)" 0.4; exit 0; fi
  hop 1 "$(name_of "$gw") ($gw)" 0.4
  if known "$ip"; then hop 2 "$(name_of "$ip") ($ip)" 0.6; else echo " 2  *  *  *"; echo " 3  *  *  *"; fi
  exit 0
fi
hop 1 "$(name_of "$gw") ($gw)" 0.4
hop 2 "edge1.isp.example (100.64.12.1)" 6
hop 3 "core3.isp.example (100.64.0.9)" 9
hop 4 "ix-peer.transit.example (100.64.250.4)" 18
if known "$ip"; then
  hop 5 "border.hosting.example (100.65.1.1)" 36
  hop 6 "$(name_of "$ip") ($ip)" 42
else
  for k in 5 6 7 8; do echo " $k  *  *  *"; done
  echo "(no reply: the host is down or drops traceroute probes)"
fi
