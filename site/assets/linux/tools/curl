NET="${AAYAT_NET:-/usr/local/share/aayat/net}"

usage() {
  echo "curl 8.5.0 (lab copy: it reaches the case network only)"
  echo "Usage: curl [options] URL"
  echo "  -s   silent        -i  show response headers too    -I  headers only"
  echo "  -v   verbose       -o FILE  save to a file           -A AGENT  user agent"
  echo "  -X METHOD          -d DATA  send data (POST)         -H 'Header: value'"
}

silent=0; inc=0; head=0; verbose=0; out=""; method=""; agent="curl/8.5.0"; data=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -s|--silent|-sS|-Ss|-sL|-Ls|-sk|-ks) silent=1 ;;
    -S|-L|-k|--insecure|--location|-f) ;;
    -i|--include) inc=1 ;;
    -I|--head) head=1 ;;
    -v|--verbose) verbose=1 ;;
    -o|--output) out="$2"; shift ;;
    -O) out="-O" ;;
    -X|--request) method="$2"; shift ;;
    -A|--user-agent) agent="$2"; shift ;;
    -d|--data|--data-raw|--data-urlencode) data="$2"; shift ;;
    -H|--header|-u|--user|-b|--cookie|-e|--referer|-m|--max-time|--connect-timeout) shift ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done

if [ -z "$url" ]; then echo "curl: no URL specified" >&2; echo "curl: try 'curl --help' for more information" >&2; exit 2; fi
if [ ! -f "$NET/routes.txt" ]; then
  echo "curl: the lab network isn't loaded yet. In the Linux lab press \"Create the lab files\"; in a notebook, run any Linux cell first." >&2
  exit 6
fi
if [ -z "$method" ]; then if [ -n "$data" ]; then method=POST; else method=GET; fi; fi
[ "$head" = 1 ] && method=HEAD

rest="${url#*://}"
scheme=http
case "$url" in https://*) scheme=https ;; esac
hostport="${rest%%/*}"
path="/${rest#*/}"
[ "$hostport" = "$rest" ] && path="/"
host="${hostport%%:*}"
port="${hostport#*:}"
if [ "$port" = "$hostport" ]; then if [ "$scheme" = https ]; then port=443; else port=80; fi; fi

decode() { echo "$1" | sed -e 's/+/ /g' -e 's/%20/ /g' -e "s/%27/'/g" -e 's/%22/"/g' -e 's/%2[Ff]/\//g' -e 's/%3[Dd]/=/g' -e 's/%3[Bb]/;/g' -e 's/%7[Cc]/|/g' -e 's/%2[Cc]/,/g' -e 's/%3[Aa]/:/g'; }

case "$host" in
  [0-9]*.[0-9]*.[0-9]*.[0-9]*) ip="$host" ;;
  *) ip=$(awk -v n="$host" '$1 == "A" && ($2 == n || $2 == n ".") { print $3; exit }' "$NET/dns.txt" 2>/dev/null) ;;
esac
if [ -z "$ip" ]; then echo "curl: (6) Could not resolve host: $host" >&2; exit 6; fi

want="$method"; [ "$want" = HEAD ] && want=GET
dpath=$(decode "$path")
route=$(awk -F'|' -v h="$host" -v ip="$ip" -v port="$port" -v m="$want" -v p="$dpath" '
  {
    n = split($1, a, ","); ok = 0
    for (i = 1; i <= n; i++) if (a[i] == h || a[i] == ip) ok = 1
    n = split($2, b, ","); pk = 0
    for (i = 1; i <= n; i++) if (b[i] == port) pk = 1
    if (ok && pk && ($3 == "*" || $3 == m) && p ~ $4) { print $5 "|" $6 "|" $7 "|" $8; exit }
  }' "$NET/routes.txt")

if [ -z "$route" ]; then
  if grep -q "^$ip|" "$NET/hosts.txt" 2>/dev/null; then
    echo "curl: (7) Failed to connect to $host port $port after 2 ms: Couldn't connect to server" >&2; exit 7
  fi
  sleep 2
  echo "curl: (28) Failed to connect to $host port $port after 3001 ms: Timeout was reached" >&2; exit 28
fi

status="${route%%|*}"; r="${route#*|}"
ctype="${r%%|*}"; r="${r#*|}"
server="${r%%|*}"; bodyfile="${r#*|}"

body=/tmp/.curl_body
binary=0
case "$bodyfile" in
  @cmd)
    q="${path#*\?}"; [ "$q" = "$path" ] && q=""
    cmd=$(decode "${q#cmd=}")
    out_cmd=$(awk -F'|' -v c="$cmd" '$1 == c { sub(/^[^|]*\|/, ""); print; exit }' "$NET/cmd.txt" 2>/dev/null)
    printf '%b\n' "$out_cmd" > $body ;;
  *.bin) binary=1; cat "$NET/www/$bodyfile" > $body 2>/dev/null ;;
  *) cat "$NET/www/$bodyfile" > $body 2>/dev/null ;;
esac

size=$(wc -c < $body | tr -d ' ')
headers() {
  echo "HTTP/1.1 $status"
  echo "Server: $server"
  echo "Date: $(date -u '+%a, %d %b %Y %H:%M:%S GMT')"
  echo "Content-Type: $ctype"
  echo "Content-Length: $size"
  echo "Connection: keep-alive"
}

if [ "$verbose" = 1 ]; then
  {
    echo "*   Trying $ip:$port..."
    echo "* Connected to $host ($ip) port $port"
    echo "> $method $path HTTP/1.1"
    echo "> Host: $hostport"
    echo "> User-Agent: $agent"
    echo "> Accept: */*"
    echo ">"
    headers | sed 's/^/< /'
    echo "<"
  } >&2
fi

if [ "$method" = HEAD ]; then headers; exit 0; fi

if [ -n "$out" ]; then
  p="${path%%\?*}"
  if [ "$out" = "-O" ]; then out=$(basename "$p"); [ "$out" = "/" ] && out=index.html; fi
  cp $body "$out"
  if [ "$silent" = 0 ]; then
    echo "  % Total    % Received % Xferd  Average Speed   Time    Time     Time  Current" >&2
    echo "                                 Dload  Upload   Total   Spent    Left  Speed" >&2
    printf '100 %5s  100 %5s    0     0   %5s      0 --:--:-- --:--:-- --:--:-- %5s\n' "$size" "$size" "$size" "$size" >&2
  fi
  exit 0
fi

[ "$inc" = 1 ] && { headers; echo; }
if [ "$binary" = 1 ]; then
  echo "Warning: Binary output can mess up your terminal. Use \"--output -\" to tell curl to output it to your terminal anyway, or consider \"--output <FILE>\" to save to a file." >&2
  exit 23
fi
cat $body
