NET="${AAYAT_NET:-/usr/local/share/aayat/net}"
short=0; rev=0; name=""; type=A
for a in "$@"; do
  case "$a" in
    +short) short=1 ;;
    -x) rev=1 ;;
    -h|--help) echo "dig (lab copy: answers for the case network only)"; echo "Usage: dig [+short] NAME   |   dig -x ADDRESS"; exit 0 ;;
    A|MX|TXT|NS|AAAA) type="$a" ;;
    +*|@*|-*) ;;
    *) name="$a" ;;
  esac
done
[ -z "$name" ] && { echo "Usage: dig [+short] NAME   |   dig -x ADDRESS"; exit 1; }

if [ "$rev" = 1 ]; then
  ans=$(awk -v n="$name" '$1 == "PTR" && $2 == n { print $3; exit }' "$NET/dns.txt" 2>/dev/null)
  rr="PTR"
  q=$(echo "$name" | awk -F. '{print $4"."$3"."$2"."$1".in-addr.arpa."}')
else
  n="${name%.}"
  ans=$(awk -v n="$n" -v t="$type" '$1 == t && ($2 == n || $2 == n ".") { $1 = ""; $2 = ""; sub(/^ +/, ""); print; exit }' "$NET/dns.txt" 2>/dev/null)
  rr="$type"
  q="$n."
fi

if [ "$short" = 1 ]; then [ -n "$ans" ] && echo "$ans"; exit 0; fi
echo "; <<>> DiG 9.18.24 <<>> $*"
echo ";; global options: +cmd"
echo ";; Got answer:"
if [ -n "$ans" ]; then st=NOERROR; c=1; else st=NXDOMAIN; c=0; fi
echo ";; ->>HEADER<<- opcode: QUERY, status: $st, id: 23117"
echo ";; flags: qr rd ra; QUERY: 1, ANSWER: $c, AUTHORITY: 0, ADDITIONAL: 1"
echo ""
echo ";; QUESTION SECTION:"
echo ";$q            IN   $rr"
if [ -n "$ans" ]; then
  echo ""
  echo ";; ANSWER SECTION:"
  echo "$q   300   IN   $rr   $ans"
fi
echo ""
echo ";; Query time: 12 msec"
echo ";; SERVER: $(awk '$1 == "SERVER" { print $2; exit }' "$NET/dns.txt" 2>/dev/null || true)#53 (UDP)"
echo ";; WHEN: $(date -u)"
