 "tasks": [
  {
   "id": "t1",
   "text": "Address web01 (192.168.2.80) and dns01 (192.168.2.53), gateway 192.168.2.1",
   "check": {
    "all": [
     {
      "dev": "web01",
      "ip": "192.168.2.80",
      "bits": 24,
      "gw": "192.168.2.1"
     },
     {
      "dev": "dns01",
      "ip": "192.168.2.53",
      "bits": 24,
      "gw": "192.168.2.1"
     }
    ]
   },
   "hint": "Design mode: click each server and fill in its panel."
  },
  {
   "id": "t2",
   "text": "Turn on the web server on web01 and the DNS server on dns01, with a record www.banyan.lan 192.168.2.80",
   "check": {
    "all": [
     {
      "svc": [
       "web01",
       "web"
      ]
     },
     {
      "svc": [
       "dns01",
       "dns"
      ]
     },
     {
      "resolve": [
       "till-1",
       "www.banyan.lan",
       "192.168.2.80"
      ]
     }
    ]
   },
   "hint": "Simulation mode: on web01's desktop open Web server and press Start; on dns01 open DNS server, add the record and press Start."
  },
  {
   "id": "t3",
   "text": "Set the DNS server to 192.168.2.53 on every computer",
   "check": {
    "all": [
     {
      "dev": "till-1",
      "dns": "192.168.2.53"
     },
     {
      "dev": "till-2",
      "dns": "192.168.2.53"
     },
     {
      "dev": "accounts",
      "dns": "192.168.2.53"
     },
     {
      "dev": "manager",
      "dns": "192.168.2.53"
     },
     {
      "dev": "web01",
      "dns": "192.168.2.53"
     },
     {
      "dev": "dns01",
      "dns": "192.168.2.53"
     }
    ]
   }
  },
  {
   "id": "t4",
   "text": "Open http://www.banyan.lan from till-1 and from accounts",
   "check": {
    "all": [
     {
      "web": [
       "till-1",
       "www.banyan.lan"
      ]
     },
     {
      "web": [
       "accounts",
       "www.banyan.lan"
      ]
     }
    ]
   },
   "hint": "Simulation mode, till-1's desktop, Web browser: www.banyan.lan"
  },
  {
   "id": "t5",
   "text": "Break till-2 in one way: change its gateway to 192.168.1.100, and see the site fail for it",
   "check": {
    "all": [
     {
      "dev": "till-2",
      "gw": "192.168.1.100"
     },
     {
      "web": [
       "till-2",
       "www.banyan.lan"
      ],
      "ok": false
     }
    ]
   },
   "hint": "Then walk the layers from till-2's Command line: ipconfig, ping the gateway, ping the DNS server, nslookup, then the Web browser.",
   "keep": true
  },
  {
   "id": "t6",
   "text": "Find the fault and fix it: till-2's gateway is 192.168.1.1 again and the site opens",
   "check": {
    "all": [
     {
      "flag": "keep:t5"
     },
     {
      "dev": "till-2",
      "gw": "192.168.1.1"
     },
     {
      "web": [
       "till-2",
       "www.banyan.lan"
      ]
     }
    ]
   }
  }
 ]
