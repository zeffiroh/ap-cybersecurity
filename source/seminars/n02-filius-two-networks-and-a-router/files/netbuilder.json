{
 "lab": "n02",
 "program": "netstarter",
 "title": "Network lab 2: Two networks and a router",
 "intro": "Banyan Books has opened a back office. Join the shop and the back office with one router.",
 "devices": [
  {
   "id": "sw-shop",
   "kind": "switch",
   "name": "sw-shop",
   "x": 215,
   "y": 190,
   "ports": 8
  },
  {
   "id": "r1",
   "kind": "router",
   "name": "router",
   "x": 380,
   "y": 190,
   "ifs": {
    "g0/0": {},
    "g0/1": {},
    "g0/2": {},
    "g0/3": {}
   }
  },
  {
   "id": "sw-back",
   "kind": "switch",
   "name": "sw-back",
   "x": 545,
   "y": 190,
   "ports": 8
  },
  {
   "id": "till-1",
   "kind": "pc",
   "name": "till-1",
   "x": 90,
   "y": 90,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  },
  {
   "id": "till-2",
   "kind": "pc",
   "name": "till-2",
   "x": 90,
   "y": 290,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  },
  {
   "id": "accounts",
   "kind": "pc",
   "name": "accounts",
   "x": 670,
   "y": 90,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  },
  {
   "id": "manager",
   "kind": "pc",
   "name": "manager",
   "x": 670,
   "y": 290,
   "os": "windows",
   "ip": "",
   "bits": 24,
   "gw": "",
   "dns": ""
  }
 ],
 "cables": [
  [
   "till-1:eth0",
   "sw-shop:1"
  ],
  [
   "till-2:eth0",
   "sw-shop:2"
  ],
  [
   "r1:g0/0",
   "sw-shop:3"
  ],
  [
   "r1:g0/1",
   "sw-back:1"
  ],
  [
   "accounts:eth0",
   "sw-back:2"
  ],
  [
   "manager:eth0",
   "sw-back:3"
  ]
 ],
 "swports": {},
 "vlanNames": {},
 "tasks": [
  {
   "id": "t1",
   "text": "Cable both networks and the router",
   "check": {
    "all": [
     {
      "linked": [
       "till-1",
       "sw-shop"
      ]
     },
     {
      "linked": [
       "till-2",
       "sw-shop"
      ]
     },
     {
      "linked": [
       "r1",
       "sw-shop"
      ]
     },
     {
      "linked": [
       "r1",
       "sw-back"
      ]
     },
     {
      "linked": [
       "accounts",
       "sw-back"
      ]
     },
     {
      "linked": [
       "manager",
       "sw-back"
      ]
     }
    ]
   },
   "hint": "Design mode, Cable. Cable the router to the shop switch first, so its first interface, G0/0, faces the shop; G0/1 then faces the back office."
  },
  {
   "id": "t2",
   "text": "Give the router 192.168.1.1 on the shop side and 192.168.2.1 on the back-office side",
   "check": {
    "all": [
     {
      "ifip": [
       "r1",
       "g0/0",
       "192.168.1.1/24"
      ]
     },
     {
      "ifip": [
       "r1",
       "g0/1",
       "192.168.2.1/24"
      ]
     }
    ]
   },
   "hint": "Click the router and fill in its interface table."
  },
  {
   "id": "t3",
   "text": "Address the four computers and set each one's gateway to the router on its own side",
   "check": {
    "all": [
     {
      "dev": "till-1",
      "ip": "192.168.1.11",
      "bits": 24,
      "gw": "192.168.1.1"
     },
     {
      "dev": "till-2",
      "ip": "192.168.1.12",
      "bits": 24,
      "gw": "192.168.1.1"
     },
     {
      "dev": "accounts",
      "ip": "192.168.2.21",
      "bits": 24,
      "gw": "192.168.2.1"
     },
     {
      "dev": "manager",
      "ip": "192.168.2.22",
      "bits": 24,
      "gw": "192.168.2.1"
     }
    ]
   }
  },
  {
   "id": "t4",
   "text": "Ping accounts from till-1 across the router",
   "check": {
    "all": [
     {
      "flag": "ping:till-1>accounts:ok"
     }
    ]
   },
   "hint": "Simulation mode, till-1's desktop, Command line: ping 192.168.2.21",
   "keep": true
  },
  {
   "id": "t5",
   "text": "Break the gateway on manager and see it lose the shop network",
   "check": {
    "all": [
     {
      "flag": "ping:manager>till-1:fail"
     }
    ]
   },
   "hint": "In Design mode clear manager's gateway, then in Simulation mode ping 192.168.1.11 from manager's Command line.",
   "keep": true
  }
 ]
}
