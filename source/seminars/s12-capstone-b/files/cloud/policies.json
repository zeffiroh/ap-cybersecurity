{
 "account": "indigo-prod",
 "identities": [
  {
   "name": "payroll-backup",
   "type": "user",
   "note": "key in backup-config.ps1; nightly upload of D:\\exports from pay-app01 (office egress 203.0.113.88)",
   "policies": [
    {
     "name": "storage-read-write",
     "statements": [
      {
       "effect": "Allow",
       "actions": [
        "GetCallerIdentity",
        "ListObjects",
        "GetObject",
        "PutObject",
        "DeleteObject"
       ],
       "resources": [
        "bucket/*",
        "*"
       ]
      }
     ]
    }
   ]
  },
  {
   "name": "c.iyer",
   "type": "user",
   "note": "cloud administrator",
   "policies": [
    {
     "name": "admin",
     "statements": [
      {
       "effect": "Allow",
       "actions": [
        "*"
       ],
       "resources": [
        "*"
       ]
      }
     ]
    }
   ]
  }
 ],
 "org_guardrails": [
  {
   "name": "protect-audit-trail",
   "statements": [
    {
     "effect": "Deny",
     "actions": [
      "StopLogging",
      "DeleteTrail"
     ],
     "resources": [
      "*"
     ]
    }
   ]
  }
 ],
 "buckets": [
  {
   "name": "payroll-exports",
   "public_read": false,
   "encrypted": true,
   "versioning": true,
   "access_logging": true,
   "note": "clients' payroll exports"
  }
 ]
}
