 "tasks": [
  {
   "id": "t1",
   "text": "Cable files01 to a staff port and address it (192.168.10.10, gateway 192.168.10.1)",
   "check": {
    "all": [
     {
      "linked": [
       "files01",
       "sw1"
      ]
     },
     {
      "dev": "files01",
      "ip": "192.168.10.10",
      "bits": 24,
      "gw": "192.168.10.1"
     }
    ]
   },
   "hint": "Staff ports are the VLAN 10 ports 1 to 12. Use Copper Straight-Through and pick Fa0/3."
  },
  {
   "id": "t2",
   "text": "Cable web-out to router G0/1, address both ends (router 203.0.113.1/24, web-out 203.0.113.10 gateway 203.0.113.1)",
   "check": {
    "all": [
     {
      "linked": [
       "web-out",
       "r1"
      ]
     },
     {
      "ifip": [
       "r1",
       "g0/1",
       "203.0.113.1/24"
      ]
     },
     {
      "ifup": [
       "r1",
       "g0/1"
      ]
     },
     {
      "dev": "web-out",
      "ip": "203.0.113.10",
      "bits": 24,
      "gw": "203.0.113.1"
     }
    ]
   }
  },
  {
   "id": "t3",
   "text": "Write access list 120 and apply it inbound on g0/0.20",
   "check": {
    "all": [
     {
      "aclin": [
       "r1",
       "g0/0.20",
       "120"
      ]
     },
     {
      "acl": [
       "r1",
       "120",
       4
      ]
     }
    ]
   },
   "hint": "access-list 120 deny ip 192.168.20.0 0.0.0.255 192.168.10.0 0.0.0.255, then permit tcp ... any eq 80, permit udp ... any eq 53, deny ip any any."
  },
  {
   "id": "t4",
   "text": "From guest-1, open web-out in the browser, then ping files01 and see it blocked",
   "check": {
    "all": [
     {
      "web": [
       "guest-1",
       "203.0.113.10"
      ]
     },
     {
      "ping": [
       "guest-1",
       "files01"
      ],
      "ok": false
     }
    ]
   },
   "hint": "CLI and Desktop tab, guest-1: curl 203.0.113.10, then ping 192.168.10.10."
  },
  {
   "id": "t5",
   "text": "Check staff are not restricted: staff-1 reaches files01 and web-out",
   "check": {
    "all": [
     {
      "ping": [
       "staff-1",
       "files01"
      ]
     },
     {
      "web": [
       "staff-1",
       "203.0.113.10"
      ]
     }
    ]
   }
  }
 ]
}
