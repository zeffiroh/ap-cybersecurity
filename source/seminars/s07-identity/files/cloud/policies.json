{
 "account": "nimbus-prod",
 "identities": [
  {
   "name": "reporting-sync",
   "type": "user",
   "note": "access key saved in C:\\Reports\\sync.ps1 on app02; uploads the nightly KPI files",
   "policies": [
    {
     "name": "reporting-full",
     "statements": [
      {
       "effect": "Allow",
       "actions": [
        "*"
       ],
       "resources": [
        "*"
       ]
      }
     ]
    }
   ]
  },
  {
   "name": "k.nair",
   "type": "user",
   "note": "Kavya Nair, cloud administrator",
   "policies": [
    {
     "name": "admin",
     "statements": [
      {
       "effect": "Allow",
       "actions": [
        "*"
       ],
       "resources": [
        "*"
       ]
      }
     ]
    }
   ]
  },
  {
   "name": "m.joshi",
   "type": "user",
   "note": "Meera Joshi, reads reports",
   "policies": [
    {
     "name": "reports-read",
     "statements": [
      {
       "effect": "Allow",
       "actions": [
        "ConsoleLogin",
        "ListBuckets",
        "GetObject"
       ],
       "resources": [
        "*",
        "bucket/nimbus-reports/*"
       ]
      }
     ]
    }
   ]
  }
 ],
 "org_guardrails": [
  {
   "name": "protect-audit-trail",
   "statements": [
    {
     "effect": "Deny",
     "actions": [
      "StopLogging",
      "DeleteTrail"
     ],
     "resources": [
      "*"
     ]
    }
   ]
  }
 ],
 "buckets": [
  {
   "name": "nimbus-reports",
   "public_read": false,
   "encrypted": true,
   "versioning": true,
   "access_logging": true,
   "note": "KPI files"
  },
  {
   "name": "client-exports",
   "public_read": false,
   "encrypted": true,
   "versioning": false,
   "access_logging": false,
   "note": "client data extracts for analytics"
  }
 ]
}
